# --- Postgres (used by docker compose) ---
POSTGRES_USER=capstone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=image_matching
# Used when running the app directly on your machine (not in Docker).
# The password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://capstone:change-me@localhost:5432/image_matching

# --- Gemini (free key from https://aistudio.google.com, no card) ---
# Not needed to browse the seeded demo data; needed to tag images or create posts.
GEMINI_API_KEY=your-gemini-key-here
VISION_MODEL=gemini-3.1-flash-lite
TEXT_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# --- Guard thresholds (chosen from the eval set; see README) ---
MIN_SIMILARITY=0.55
MIN_CONFIDENCE=0.60
MATCH_TOP_K=10

# --- Cost tracking: USD per 1M tokens (0 is accurate on the free tier) ---
VISION_INPUT_PRICE_PER_M=0.0
VISION_OUTPUT_PRICE_PER_M=0.0
EMBEDDING_PRICE_PER_M=0.0
DAILY_BUDGET_USD=1.0

# --- Batch job ---
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_BASE_SECONDS=3.0
JOB_DELAY_SECONDS=1.0
JOB_MAX_CONSECUTIVE_FAILURES=3
# Optional: Slack/Discord-style webhook that receives job failure alerts.
ALERT_WEBHOOK_URL=